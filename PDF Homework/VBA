Public Sub Refresh_Dashboard()
    Dim wsD As Worksheet, wsM As Worksheet
    Set wsD = ThisWorkbook.Worksheets(SH_DASHBOARD)
    Set wsM = ThisWorkbook.Worksheets(SH_MASTER_TABLE)
    
    ' Clear old data in the relevant ranges
    wsD.Range("A5:B14").ClearContents  ' Overdue
    wsD.Range("A18:B27").ClearContents ' Upcoming
    wsD.Range("A31:B40").ClearContents ' Largest relationships
    
    ' 1) Gather Overdue (Next Meeting < Today)
    Dim overdueItems() As Variant
    overdueItems = GatherMeetings(wsM, "<", Date, 10) ' top 10
    
    ' Write them in A5 downward
    WriteDashboardList wsD, overdueItems, 5
    
    ' 2) Gather Upcoming (Today <= Next < = Today+7)
    Dim upcomingItems() As Variant
    upcomingItems = GatherMeetingsRange(wsM, ">=", Date, "<=", Date + 7, 10)
    
    ' Write them in A18 downward
    WriteDashboardList wsD, upcomingItems, 18
    
    ' 3) Largest relationships
    ' Summation by relationship name. Then pick top 5 or 10.
    Dim largest() As Variant
    largest = GatherLargestRelationships(wsM, 10)
    WriteDashboardList wsD, largest, 31
    
    MsgBox "Dashboard refreshed!", vbInformation
End Sub

' Gathers up to 'maxItems' meetings from Master_Table where NextMeeting < / = / > some date
' We'll store Relationship + NextMeeting in an array, or you can store more columns.
Private Function GatherMeetings(wsM As Worksheet, compOperator As String, compDate As Date, maxItems As Long) As Variant()
    Dim lr As Long, i As Long
    lr = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    
    Dim results As New Collection
    Dim nxt As Variant, rel As String
    
    For i = 2 To lr
        nxt = wsM.Cells(i, 9).Value  ' col9 = NextMeeting
        rel = wsM.Cells(i, 7).Value  ' col7 = Relationship
        If IsDate(nxt) And rel <> "" Then
            Select Case compOperator
                Case "<"
                    If nxt < compDate Then
                        results.Add rel & "|" & Format(nxt, "mm/dd/yyyy")
                    End If
                Case ">"
                    If nxt > compDate Then
                        results.Add rel & "|" & Format(nxt, "mm/dd/yyyy")
                    End If
                Case "<="
                    If nxt <= compDate Then
                        results.Add rel & "|" & Format(nxt, "mm/dd/yyyy")
                    End If
                Case ">="
                    If nxt >= compDate Then
                        results.Add rel & "|" & Format(nxt, "mm/dd/yyyy")
                    End If
                Case Else
                    ' do nothing
            End Select
        End If
    Next i
    
    ' Convert the collection to an array, maybe we can limit to maxItems
    Dim arr() As Variant
    Dim count As Long
    count = results.Count
    If count > maxItems Then count = maxItems
    
    ReDim arr(1 To count, 1 To 2)
    
    Dim idx As Long
    For idx = 1 To count
        Dim strData As String
        strData = results(idx)
        arr(idx, 1) = Split(strData, "|")(0) ' Relationship
        arr(idx, 2) = Split(strData, "|")(1) ' NextMeeting
    Next idx
    
    GatherMeetings = arr
End Function

' Variation: GatherMeetingsRange => NextMeeting must satisfy 2 operators
Private Function GatherMeetingsRange(wsM As Worksheet, op1 As String, val1 As Date, op2 As String, val2 As Date, maxItems As Long) As Variant()
    Dim lr As Long, i As Long
    lr = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    
    Dim results As New Collection
    Dim nxt As Variant, rel As String
    
    For i = 2 To lr
        nxt = wsM.Cells(i, 9).Value
        rel = wsM.Cells(i, 7).Value
        If IsDate(nxt) And rel <> "" Then
            If CompareDate(nxt, op1, val1) And CompareDate(nxt, op2, val2) Then
                results.Add rel & "|" & Format(nxt, "mm/dd/yyyy")
            End If
        End If
    Next i
    
    ' convert to array, limit to maxItems
    Dim arr() As Variant
    Dim count As Long
    count = results.Count
    If count > maxItems Then count = maxItems
    
    ReDim arr(1 To count, 1 To 2)
    Dim idx As Long
    For idx = 1 To count
        Dim strData As String
        strData = results(idx)
        arr(idx, 1) = Split(strData, "|")(0) ' Relationship
        arr(idx, 2) = Split(strData, "|")(1) ' NextMeeting
    Next idx
    
    GatherMeetingsRange = arr
End Function

' CompareDate: simple helper to compare dVal with a date using the operator: <, <=, >, >=
Private Function CompareDate(dVal As Date, op As String, dComp As Date) As Boolean
    Select Case op
        Case "<": CompareDate = (dVal < dComp)
        Case "<=": CompareDate = (dVal <= dComp)
        Case ">": CompareDate = (dVal > dComp)
        Case ">=": CompareDate = (dVal >= dComp)
        Case Else: CompareDate = False
    End Select
End Function

' Summarizes total Market Value (col6) by Relationship (col7) in Master_Table
' returns an array of top N relationships
Private Function GatherLargestRelationships(wsM As Worksheet, topN As Long) As Variant()
    Dim lr As Long, i As Long
    lr = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    
    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    Dim rel As String, valM As Double
    
    For i = 2 To lr
        rel = wsM.Cells(i, 7).Value
        If rel <> "" Then
            valM = wsM.Cells(i, 6).Value ' col6 = total market value
            If dict.exists(rel) Then
                dict(rel) = dict(rel) + valM
            Else
                dict.Add rel, valM
            End If
        End If
    Next i
    
    ' Turn dict into an array of {rel, totalVal}, then sort descending
    Dim arr() As Variant
    ReDim arr(1 To dict.Count, 1 To 2)
    Dim idx As Long: idx = 1
    Dim k As Variant
    For Each k In dict.keys
        arr(idx, 1) = k
        arr(idx, 2) = dict(k)
        idx = idx + 1
    Next k
    
    ' Sort arr by col2 descending
    QuickSort2D arr, 1, dict.Count, 2, False
    
    ' Truncate to topN
    Dim limit As Long: limit = IIf(dict.Count < topN, dict.Count, topN)
    Dim outArr() As Variant
    ReDim outArr(1 To limit, 1 To 2)
    For i = 1 To limit
        outArr(i, 1) = arr(i, 1)
        outArr(i, 2) = arr(i, 2)
    Next i
    
    GatherLargestRelationships = outArr
End Function

' Writes a 2D array of [rowIndex, col1/2] to the dashboard,
' starting at colA, rowStart in the Dashboard sheet.
Private Sub WriteDashboardList(wsD As Worksheet, dat() As Variant, rowStart As Long)
    If Not Not dat = Nothing Then
        Dim ub As Long
        ub = UBound(dat, 1)
        Dim i As Long
        For i = 1 To ub
            wsD.Cells(rowStart + i - 1, 1).Value = dat(i, 1)
            wsD.Cells(rowStart + i - 1, 2).Value = dat(i, 2)
        Next i
    End If
End Sub
' QuickSort2D array on a specified column. ascending or descending
Private Sub QuickSort2D(arr As Variant, ByVal first As Long, ByVal last As Long, ByVal sortCol As Long, ByVal ascending As Boolean)
   Dim pivot As Variant, temp1 As Variant, temp2 As Variant
   Dim f As Long, l As Long
   
   f = first
   l = last
   pivot = arr((first + last) \ 2, sortCol)
   
   Do While f <= l
      If ascending Then
         Do While arr(f, sortCol) < pivot: f = f + 1: Loop
         Do While arr(l, sortCol) > pivot: l = l - 1: Loop
      Else
         Do While arr(f, sortCol) > pivot: f = f + 1: Loop
         Do While arr(l, sortCol) < pivot: l = l - 1: Loop
      End If
      
      If f <= l Then
         ' swap entire row f and l
         Dim c As Long
         For c = LBound(arr, 2) To UBound(arr, 2)
             temp1 = arr(f, c)
             arr(f, c) = arr(l, c)
             arr(l, c) = temp1
         Next c
         f = f + 1
         l = l - 1
      End If
   Loop
   
   If first < l Then QuickSort2D arr, first, l, sortCol, ascending
   If f < last Then QuickSort2D arr, f, last, sortCol, ascending
End Sub
