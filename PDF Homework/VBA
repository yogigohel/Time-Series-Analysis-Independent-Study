'In Module
Sub ImportFile(filePath As String, sheetName As String)
    Dim wbSource As Workbook
    Dim wsSource As Worksheet
    Dim wsDest As Worksheet
    Application.ScreenUpdating = False

    ' Check if sheet with sheetName already exists
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = ThisWorkbook.Sheets(sheetName)
    On Error GoTo 0
    If Not ws Is Nothing Then
        ' Sheet exists, delete it
        Application.DisplayAlerts = False
        ws.Delete
        Application.DisplayAlerts = True
    End If

    Set wbSource = Workbooks.Open(filePath, ReadOnly:=True)
    Set wsSource = wbSource.Sheets(1) ' Assume data is in the first sheet

    ' Copy the sheet to the current workbook
    wsSource.Copy After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count)
    Set wsDest = ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count)
    wsDest.Name = sheetName

    wbSource.Close SaveChanges:=False
    Application.ScreenUpdating = True
End Sub

Sub CreateTableFromSheet(sheetName As String)
    Dim ws As Worksheet
    Dim lo As ListObject
    Dim tblName As String
    Set ws = ThisWorkbook.Sheets(sheetName)
    tblName = sheetName

    ' Check if the sheet already contains a table
    If ws.ListObjects.Count > 0 Then
        ' Rename the existing table
        ws.ListObjects(1).Name = tblName
    Else
        ' Create a new table
        Set lo = ws.ListObjects.Add(xlSrcRange, ws.Range("A1").CurrentRegion, , xlYes)
        lo.Name = tblName
    End If
End Sub

Sub ManipulateData()
    ' Steps as per the instructions
    RearrangeColumns
    CreateNewColumns
    UnitTest
End Sub

Sub RearrangeColumns()
    Dim ws As Worksheet
    Dim lo As ListObject
    Dim colIndex As Long
    Dim destIndex As Long

    Set ws = ThisWorkbook.Sheets("Relationships")
    Set lo = ws.ListObjects("Relationships")

    ' Find the column "Master Account Name"
    colIndex = lo.ListColumns("Master Account Name").Index
    ' Move it to be the third column
    destIndex = 3

    If colIndex <> destIndex Then
        lo.ListColumns("Master Account Name").Range.Cut
        lo.ListColumns(destIndex).Range.Insert Shift:=xlToRight
        Application.CutCopyMode = False
    End If
End Sub

Sub CreateNewColumns()
    Dim wsHoldings As Worksheet
    Dim wsRelationships As Worksheet
    Dim loHoldings As ListObject
    Dim loRelationships As ListObject

    Set wsHoldings = ThisWorkbook.Sheets("Holdings")
    Set wsRelationships = ThisWorkbook.Sheets("Relationships")
    Set loHoldings = wsHoldings.ListObjects("Holdings")
    Set loRelationships = wsRelationships.ListObjects("Relationships")

    ' Insert columns as per instructions
    InsertNewColumn loRelationships, 4, "Unrealized Short Term Losses"
    InsertNewColumn loRelationships, 5, "Unrealized Long Term Losses"
    InsertNewColumn loRelationships, 6, "Total Unrealized Losses"
    InsertNewColumn loRelationships, 7, "Unrealized Losses MA"
    InsertNewColumn loRelationships, 8, "Realized Gain/Loss"
    InsertNewColumn loRelationships, 9, "Realized Gains/Losses MA"

    ' Populate the formulas
    PopulateFormulas loRelationships, loHoldings
End Sub

Sub InsertNewColumn(lo As ListObject, position As Long, headerName As String)
    ' Insert a new column at specified position with the given header
    lo.ListColumns.Add position:=position
    lo.HeaderRowRange.Cells(1, position).Value = headerName
End Sub

Sub PopulateFormulas(loRelationships As ListObject, loHoldings As ListObject)
    Dim wsRelationships As Worksheet
    Dim wsHoldings As Worksheet
    Set wsRelationships = loRelationships.Parent
    Set wsHoldings = loHoldings.Parent

    ' Column indices
    Dim colUSTL As Long, colULTL As Long, colTUL As Long
    Dim colULMA As Long, colRGL As Long, colRGLMA As Long
    Dim colGLSTYtd As Long, colGLLTYtd As Long

    colUSTL = loRelationships.ListColumns("Unrealized Short Term Losses").Index
    colULTL = loRelationships.ListColumns("Unrealized Long Term Losses").Index
    colTUL = loRelationships.ListColumns("Total Unrealized Losses").Index
    colULMA = loRelationships.ListColumns("Unrealized Losses MA").Index
    colRGL = loRelationships.ListColumns("Realized Gain/Loss").Index
    colRGLMA = loRelationships.ListColumns("Realized Gains/Losses MA").Index

    colGLSTYtd = loRelationships.ListColumns("Gain/Loss Short Term Ytd").Index
    colGLLTYtd = loRelationships.ListColumns("Gain/Loss Long Term Ytd").Index

    ' Apply formulas to the entire columns
    With loRelationships.DataBodyRange
        ' Unrealized Short Term Losses
        .Columns(colUSTL).Formula = "=SUMIFS(Holdings[Unrealized ShortTerm Gain/Loss],Holdings[Account#],[@[Account#]],Holdings[Unrealized ShortTerm Gain/Loss],""<0"")"
        ' Unrealized Long Term Losses
        .Columns(colULTL).Formula = "=SUMIFS(Holdings[Unrealized LongTerm Gain/Loss],Holdings[Account#],[@[Account#]],Holdings[Unrealized LongTerm Gain/Loss],""<0"")"
        ' Total Unrealized Losses
        .Columns(colTUL).Formula = "=[""Unrealized Short Term Losses""]+[""Unrealized Long Term Losses""]"
        ' Unrealized Losses MA
        .Columns(colULMA).Formula = "=SUMIFS([""Total Unrealized Losses""],[Master Account Name],[@[Master Account Name]])"
        ' Realized Gain/Loss
        .Columns(colRGL).Formula = "=[""Gain/Loss Short Term Ytd""]+[""Gain/Loss Long Term Ytd""]"
        ' Realized Gains/Losses MA
        .Columns(colRGLMA).Formula = "=SUMIFS([""Realized Gain/Loss""],[Master Account Name],[@[Master Account Name]])"
    End With
End Sub

Sub UnitTest()
    ' Check that the columns have been added
    Dim loRelationships As ListObject
    Set loRelationships = ThisWorkbook.Sheets("Relationships").ListObjects("Relationships")

    Dim requiredColumns As Variant
    requiredColumns = Array("Unrealized Short Term Losses", "Unrealized Long Term Losses", "Total Unrealized Losses", "Unrealized Losses MA", "Realized Gain/Loss", "Realized Gains/Losses MA")

    Dim i As Long
    Dim colExists As Boolean
    For i = LBound(requiredColumns) To UBound(requiredColumns)
        colExists = False
        On Error Resume Next
        colExists = Not loRelationships.ListColumns(requiredColumns(i)) Is Nothing
        On Error GoTo 0
        If Not colExists Then
            MsgBox "Column '" & requiredColumns(i) & "' is missing in Relationships table.", vbCritical
            Exit Sub
        End If
    Next i

    MsgBox "Unit test passed. All required columns are present.", vbInformation
End Sub
