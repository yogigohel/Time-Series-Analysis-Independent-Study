End Sub

Sub InsertNewColumn(lo As ListObject, position As Long, headerName As String)
    ' Insert a new column at specified position with the given header
    lo.ListColumns.Add position:=position
    lo.HeaderRowRange.Cells(1, position).Value = headerName
End Sub

' New Subroutine to Populate Data Without Using SUMIF
Sub PopulateDataWithoutSUMIF()
    Dim wsHoldings As Worksheet
    Dim wsRelationships As Worksheet
    Dim loHoldings As ListObject
    Dim loRelationships As ListObject

    Set wsHoldings = ThisWorkbook.Sheets("Holdings")
    Set wsRelationships = ThisWorkbook.Sheets("Relationships")
    Set loHoldings = wsHoldings.ListObjects("Holdings")
    Set loRelationships = wsRelationships.ListObjects("Relationships")

    ' Create Dictionaries to store sums
    Dim dictUSTLosses As Object
    Dim dictULTLosses As Object
    Dim dictTotalUnrealizedLossesMA As Object
    Dim dictRealizedGainsLossesMA As Object

    Set dictUSTLosses = CreateObject("Scripting.Dictionary")
    Set dictULTLosses = CreateObject("Scripting.Dictionary")
    Set dictTotalUnrealizedLossesMA = CreateObject("Scripting.Dictionary")
    Set dictRealizedGainsLossesMA = CreateObject("Scripting.Dictionary")

    ' Step 1: Compute Unrealized Short Term Losses and Long Term Losses per Account#
    Dim i As Long
    Dim acctNum As Variant
    Dim ustGainLoss As Double
    Dim ultGainLoss As Double

    With loHoldings.DataBodyRange
        For i = 1 To .Rows.Count
            acctNum = .Cells(i, loHoldings.ListColumns("Account#").Index).Value

            ' Unrealized Short Term Gain/Loss
            ustGainLoss = .Cells(i, loHoldings.ListColumns("Unrealized ShortTerm Gain/Loss").Index).Value
            If IsNumeric(ustGainLoss) And ustGainLoss < 0 Then
                If dictUSTLosses.Exists(acctNum) Then
                    dictUSTLosses(acctNum) = dictUSTLosses(acctNum) + ustGainLoss
                Else
                    dictUSTLosses.Add acctNum, ustGainLoss
                End If
            End If

            ' Unrealized Long Term Gain/Loss
            ultGainLoss = .Cells(i, loHoldings.ListColumns("Unrealized LongTerm Gain/Loss").Index).Value
            If IsNumeric(ultGainLoss) And ultGainLoss < 0 Then
                If dictULTLosses.Exists(acctNum) Then
                    dictULTLosses(acctNum) = dictULTLosses(acctNum) + ultGainLoss
                Else
                    dictULTLosses.Add acctNum, ultGainLoss
                End If
            End If
        Next i
    End With

    ' Step 2: Populate Unrealized Losses in Relationships Table
    Dim accountNumber As Variant
    Dim masterAccountName As String
    Dim totalUnrealizedLoss As Double
    Dim realizedGainLoss As Double
    Dim gainLossSTYtd As Double
    Dim gainLossLTYtd As Double

    With loRelationships.DataBodyRange
        For i = 1 To .Rows.Count
            accountNumber = .Cells(i, loRelationships.ListColumns("Account#").Index).Value
            masterAccountName = .Cells(i, loRelationships.ListColumns("Master Account Name").Index).Value

            ' Unrealized Short Term Losses
            If dictUSTLosses.Exists(accountNumber) Then
                .Cells(i, loRelationships.ListColumns("Unrealized Short Term Losses").Index).Value = dictUSTLosses(accountNumber)
            Else
                .Cells(i, loRelationships.ListColumns("Unrealized Short Term Losses").Index).Value = 0
            End If

            ' Unrealized Long Term Losses
            If dictULTLosses.Exists(accountNumber) Then
                .Cells(i, loRelationships.ListColumns("Unrealized Long Term Losses").Index).Value = dictULTLosses(accountNumber)
            Else
                .Cells(i, loRelationships.ListColumns("Unrealized Long Term Losses").Index).Value = 0
            End If

            ' Total Unrealized Losses
            totalUnrealizedLoss = .Cells(i, loRelationships.ListColumns("Unrealized Short Term Losses").Index).Value + _
                                  .Cells(i, loRelationships.ListColumns("Unrealized Long Term Losses").Index).Value
            .Cells(i, loRelationships.ListColumns("Total Unrealized Losses").Index).Value = totalUnrealizedLoss

            ' Accumulate Total Unrealized Losses by Master Account Name
            If dictTotalUnrealizedLossesMA.Exists(masterAccountName) Then
                dictTotalUnrealizedLossesMA(masterAccountName) = dictTotalUnrealizedLossesMA(masterAccountName) + totalUnrealizedLoss
            Else
                dictTotalUnrealizedLossesMA.Add masterAccountName, totalUnrealizedLoss
            End If

            ' Realized Gain/Loss
            gainLossSTYtd = .Cells(i, loRelationships.ListColumns("Gain/Loss Short Term Ytd").Index).Value
            gainLossLTYtd = .Cells(i, loRelationships.ListColumns("Gain/Loss Long Term Ytd").Index).Value

            If Not IsNumeric(gainLossSTYtd) Then gainLossSTYtd = 0
            If Not IsNumeric(gainLossLTYtd) Then gainLossLTYtd = 0

            realizedGainLoss = gainLossSTYtd + gainLossLTYtd
            .Cells(i, loRelationships.ListColumns("Realized Gain/Loss").Index).Value = realizedGainLoss

            ' Accumulate Realized Gain/Loss by Master Account Name
            If dictRealizedGainsLossesMA.Exists(masterAccountName) Then
                dictRealizedGainsLossesMA(masterAccountName) = dictRealizedGainsLossesMA(masterAccountName) + realizedGainLoss
            Else
                dictRealizedGainsLossesMA.Add masterAccountName, realizedGainLoss
            End If
        Next i
    End With

    ' Step 3: Populate Unrealized Losses MA and Realized Gains/Losses MA
    With loRelationships.DataBodyRange
        For i = 1 To .Rows.Count
            masterAccountName = .Cells(i, loRelationships.ListColumns("Master Account Name").Index).Value

            ' Unrealized Losses MA
            If dictTotalUnrealizedLossesMA.Exists(masterAccountName) Then
                .Cells(i, loRelationships.ListColumns("Unrealized Losses MA").Index).Value = dictTotalUnrealizedLossesMA(masterAccountName)
            Else
                .Cells(i, loRelationships.ListColumns("Unrealized Losses MA").Index).Value = 0
            End If

            ' Realized Gains/Losses MA
            If dictRealizedGainsLossesMA.Exists(masterAccountName) Then
                .Cells(i, loRelationships.ListColumns("Realized Gains/Losses MA").Index).Value = dictRealizedGainsLossesMA(masterAccountName)
            Else
                .Cells(i, loRelationships.ListColumns("Realized Gains/Losses MA").Index).Value = 0
            End If
        Next i
    End With
End Sub

