=LET(
    new_title, UPPER(New_Submission!B1),
    new_description, UPPER(New_Submission!B2),
    new_text, new_title & " " & new_description,
    keywords, UPPER(Keywords!$A$2:$A$1000),
    shorthands, UPPER(Keywords!$B$2:$B$1000),
    combined_keywords, IF(shorthands="", keywords, shorthands),
    keyword_presence_new, --(ISNUMBER(SEARCH(keywords, new_text)) + ISNUMBER(SEARCH(shorthands, new_text)) > 0),
    vector_new, keyword_presence_new,
    
    submission_id, A2,
    row_num, MATCH(submission_id, Vectorization!$A$2:$A$1000, 0) +1,  // Adjust based on Vectorization data
    vector_hist, INDEX(Vectorization!$B$2:$Z$1000, row_num -1, 0),  // Adjust columns based on keywords
    
    dot_product, SUM(vector_new * vector_hist),
    magnitude_new, SQRT(SUM(vector_new * vector_new)),
    magnitude_hist, SQRT(SUM(vector_hist * vector_hist)),
    similarity, IF(magnitude_new * magnitude_hist = 0, 0, dot_product / (magnitude_new * magnitude_hist)),
    similarity
)


// For cell E2 (Magnitude of new submission vector):
=SQRT(SUMPRODUCT(D2:D2))

// For cell F2 (Magnitude of historical vector):
=SQRT(SUMPRODUCT(Vectorization!B2:XFD2))

// For cell G2 (Dot Product):
=SUMPRODUCT(D2:D2, Vectorization!B2:XFD2)

// For cell H2 (Similarity Score):
=IF(AND(E2>0,F2>0), G2/(E2*F2), 0)

// For cell I2 (Combined Score):
=H2*(1 + B2*0.5 + C2*0.3)

// For cell J2 (Reviewed With):
=XLOOKUP(A2, Historical_Data[SubmissionID], Historical_Data[Reviewed with])

7. Create Top 10 Results section:
```
H1: "Top 10 Suggested Reviewers"
H2: =LET(
    filtered_data, FILTER(
        F2:F1000,
        AND(
            E2:E1000>0,
            B2:B1000=1  // Must match category
        )
    ),
    filtered_scores, FILTER(
        E2:E1000,
        AND(
            E2:E1000>0,
            B2:B1000=1  // Must match category
        )
    ),
    SORT(
        filtered_data,
        filtered_scores,
        -1
    )
)
```

