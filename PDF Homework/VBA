Option Explicit

' Macro to copy specified columns from "Relationships" table to "Output" sheet
Sub CopyRelationshipsToOutput()
    Dim wb As Workbook
    Dim wsSource As Worksheet
    Dim wsOutput As Worksheet
    Dim tbl As ListObject
    Dim colNames As Variant
    Dim i As Long
    Dim lastRow As Long
    Dim outputRange As Range
    Dim outputTable As ListObject
    Dim header As String
    Dim srcCol As Range
    Dim tblFound As Boolean
    
    ' Define the columns in the specified order
    colNames = Array( _
        "Account#", _
        "Acct Name", _
        "Master Account Name", _
        "Unrealised Short Term Losses", _
        "Unrealised Long Term Losses", _
        "Unrealized Losses", _
        "Unrealized Losses MA", _
        "Gains/Losses Short Term Ytd", _
        "Gains/Losses Long Term Ytd", _
        "Realized Gain/Loss", _
        "Realized Gain/Losses MA" _
    )
    
    Set wb = ThisWorkbook
    
    ' Find the "Relationships" table in any worksheet
    tblFound = False
    For Each wsSource In wb.Worksheets
        On Error Resume Next
        Set tbl = wsSource.ListObjects("Relationships")
        On Error GoTo 0
        If Not tbl Is Nothing Then
            tblFound = True
            Exit For
        End If
    Next wsSource
    
    If Not tblFound Then
        MsgBox "Table 'Relationships' not found.", vbExclamation
        Exit Sub
    End If
    
    ' Create or clear the "Output" sheet
    On Error Resume Next
    Set wsOutput = wb.Worksheets("Output")
    On Error GoTo 0
    
    If wsOutput Is Nothing Then
        Set wsOutput = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        wsOutput.Name = "Output"
    Else
        wsOutput.Cells.Clear
    End If
    
    ' Copy the headers and data
    For i = LBound(colNames) To UBound(colNames)
        header = colNames(i)
        On Error Resume Next
        Set srcCol = tbl.ListColumns(header).DataBodyRange
        On Error GoTo 0
        
        If srcCol Is Nothing Then
            MsgBox "Column '" & header & "' not found in 'Relationships' table.", vbExclamation
            Exit Sub
        End If
        
        ' Copy header
        wsOutput.Cells(1, i + 1).Value = header
        
        ' Copy data
        srcCol.Copy Destination:=wsOutput.Cells(2, i + 1)
        
        Set srcCol = Nothing
    Next i
    
    ' Determine the last row with data
    lastRow = wsOutput.Cells(wsOutput.Rows.Count, 1).End(xlUp).Row
    
    ' Define the output range
    Set outputRange = wsOutput.Range(wsOutput.Cells(1, 1), wsOutput.Cells(lastRow, UBound(colNames) + 1))
    
    ' Convert the range to a table
    Set outputTable = wsOutput.ListObjects.Add(xlSrcRange, outputRange, , xlYes)
    outputTable.Name = "OutputTable"
    
    ' Set the font to "Connections"
    outputRange.Font.Name = "Connections"
    
    ' Auto-fit columns for better readability
    outputRange.Columns.AutoFit
    
    ' Apply alternating white and light gray shading
    ' Using a built-in table style that closely matches the desired shading
    outputTable.TableStyle = "TableStyleLight9" ' You can change this to another style if preferred
    
    MsgBox "Data successfully copied to the 'Output' sheet.", vbInformation
End Sub

' Macro to export the "Output" sheet as a PDF
Sub ExportReportToPDF()
    Dim wb As Workbook
    Dim wsOutput As Worksheet
    Dim pdfPath As String
    Dim fDialog As FileDialog
    Dim savePath As String
    
    Set wb = ThisWorkbook
    
    ' Check if "Output" sheet exists
    On Error Resume Next
    Set wsOutput = wb.Worksheets("Output")
    On Error GoTo 0
    
    If wsOutput Is Nothing Then
        MsgBox "'Output' sheet not found. Please run the copy macro first.", vbExclamation
        Exit Sub
    End If
    
    ' Prompt user to select save location
    Set fDialog = Application.FileDialog(msoFileDialogSaveAs)
    With fDialog
        .Title = "Save PDF Report"
        .Filters.Clear
        .Filters.Add "PDF Files", "*.pdf"
        .FilterIndex = 1
        .InitialFileName = "Gains_Losses_Report.pdf"
        If .Show <> -1 Then
            ' User cancelled
            Exit Sub
        End If
        savePath = .SelectedItems(1)
        ' Ensure the file has .pdf extension
        If LCase(Right(savePath, 4)) <> ".pdf" Then
            savePath = savePath & ".pdf"
        End If
    End With
    
    ' Export the "Output" sheet as PDF
    On Error GoTo ExportError
    wsOutput.ExportAsFixedFormat Type:=xlTypePDF, Filename:=savePath, _
        Quality:=xlQualityStandard, IncludeDocProperties:=True, _
        IgnorePrintAreas:=False, OpenAfterPublish:=True
    
    MsgBox "Report successfully exported to:" & vbCrLf & savePath, vbInformation
    Exit Sub
    
ExportError:
    MsgBox "An error occurred while exporting the PDF.", vbCritical
End Sub