' ============================================
'   HELPER: GetColumnByHeader
' ============================================
' Returns the column number (Long) of the header matching hdrName
' in row 1 of the given worksheet. Returns 0 if not found.
Private Function GetColumnByHeader(ws As Worksheet, hdrName As String) As Long
    Dim rngFound As Range
    Set rngFound = ws.Rows(1).Find(What:=hdrName, LookIn:=xlValues, LookAt:=xlWhole)
    If Not rngFound Is Nothing Then
        GetColumnByHeader = rngFound.Column
    Else
        GetColumnByHeader = 0
    End If
End Function


' ============================================
'   HELPER: RemoveDuplicates
' ============================================
' Removes duplicates in the given worksheet based on a particular column index.
Private Sub RemoveDuplicates(ws As Worksheet, ByVal colIndex As Long)
    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, colIndex).End(xlUp).Row
    If lastRow < 2 Then Exit Sub
    
    With ws.Range("A1").CurrentRegion
        .RemoveDuplicates Columns:=colIndex, Header:=xlYes
    End With
End Sub


' ============================================
'   HELPER: ApplyCalendarConditionalFormatting
' ============================================
' Example color‐coding on Next Meeting Date column in Meeting_Calendar:
'  - Overdue (Next Meeting < Today)
'  - Upcoming (within 7 days)
'  - Future (beyond 7 days)
Private Sub ApplyCalendarConditionalFormatting(ws As Worksheet, ByVal lastDataRow As Long)
    Dim rngDates As Range
    If lastDataRow < 2 Then Exit Sub
    
    ' Adjust column "E" (5) for Next Meeting Date
    Set rngDates = ws.Range("E2:E" & lastDataRow)
    
    ' Clear existing CF
    rngDates.FormatConditions.Delete
    
    ' Overdue (red fill) when cell value < Today
    With rngDates.FormatConditions.Add(Type:=xlCellValue, Operator:=xlLess, Formula1:="=TODAY()")
        .Interior.Color = RGB(255, 0, 0) ' Red
    End With
    
    ' Upcoming (orange fill) when cell value between Today and Today+7
    With rngDates.FormatConditions.Add(Type:=xlExpression, Formula1:="=AND(E2>=TODAY(),E2<=TODAY()+7)")
        .Interior.Color = RGB(255, 165, 0) ' Orange
    End With
    
    ' Future (green fill) when cell value > Today+7
    With rngDates.FormatConditions.Add(Type:=xlExpression, Formula1:="=E2>TODAY()+7")
        .Interior.Color = RGB(0, 255, 0) ' Green
    End With
End Sub

