' In a Class Module named "FileImporterState"
Option Explicit

Public HoldingsFile As String
Public RelationshipsFile As String

' In UserForm named "fileImporter"
Option Explicit

Private State As FileImporterState

Private Sub UserForm_Initialize()
    Set State = New FileImporterState
End Sub

Private Sub btnHoldings_Click()
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    
    With fd
        .Title = "Select Holdings File"
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xls; *.xlsx; *.xlsm", 1
        .AllowMultiSelect = False
        
        If .Show = -1 Then
            State.HoldingsFile = .SelectedItems(1)
            lblHoldingsPath.Caption = State.HoldingsFile
        End If
    End With
End Sub

Private Sub btnRelationships_Click()
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    
    With fd
        .Title = "Select Relationships File"
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xls; *.xlsx; *.xlsm", 1
        .AllowMultiSelect = False
        
        If .Show = -1 Then
            State.RelationshipsFile = .SelectedItems(1)
            lblRelationshipsPath.Caption = State.RelationshipsFile
        End If
    End With
End Sub

Private Sub btnSubmit_Click()
    If State.HoldingsFile = "" Or State.RelationshipsFile = "" Then
        MsgBox "Please select both files before submitting.", vbExclamation
        Exit Sub
    End If
    
    On Error GoTo ErrorHandler
    
    ' Disable screen updating and alerts
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    ' Import and process sheets
    Call ImportAndProcessSheets(State.HoldingsFile, State.RelationshipsFile)
    
    ' Enable screen updating and alerts
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    
    MsgBox "Processing completed successfully!", vbInformation
    Unload Me
    Exit Sub

ErrorHandler:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox "An error occurred: " & Err.Description, vbCritical
    Err.Clear
End Sub

' In a Module named "DataProcessor"
Option Explicit

Public Sub ImportAndProcessSheets(HoldingsFile As String, RelationshipsFile As String)
    ' Import Holdings
    Dim holdingsWs As Worksheet
    Set holdingsWs = ImportSheet(HoldingsFile)
    
    ' Import Relationships
    Dim relationshipsWs As Worksheet
    Set relationshipsWs = ImportSheet(RelationshipsFile)
    
    ' Convert to tables
    CreateTable holdingsWs, "Holdings"
    CreateTable relationshipsWs, "Relationships"
    
    ' Process Relationships table
    ProcessRelationshipsTable relationshipsWs
End Sub

Private Function ImportSheet(filePath As String) As Worksheet
    Dim wbSource As Workbook
    Dim ws As Worksheet
    
    Set wbSource = Workbooks.Open(filePath)
    Set ws = wbSource.Sheets(1)
    ws.Copy After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count)
    Set ImportSheet = ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count)
    wbSource.Close SaveChanges:=False
End Function

Private Sub CreateTable(ws As Worksheet, tableName As String)
    Dim rng As Range
    Set rng = ws.UsedRange
    
    ' Delete existing table if it exists
    On Error Resume Next
    ThisWorkbook.Tables(tableName).Delete
    On Error GoTo 0
    
    ' Create new table
    ws.ListObjects.Add(xlSrcRange, rng, , xlYes).Name = tableName
End Sub

Private Sub ProcessRelationshipsTable(ws As Worksheet)
    Dim tbl As ListObject
    Set tbl = ws.ListObjects("Relationships")
    
    ' Move Master Account Name to third position
    MoveColumn tbl, "Master Account Name", 3
    
    ' Add Unrealized Short Term Losses column
    AddUnrealizedLossesColumn tbl, "Unrealized Short Term Losses", "Unrealized ShortTerm Gain/Loss"
    
    ' Add Unrealized Long Term Losses column
    AddUnrealizedLossesColumn tbl, "Unrealized Long Term Losses", "Unrealized LongTerm Gain/Loss"
    
    ' Add Total Unrealized Losses column
    AddTotalUnrealizedLossesColumn tbl
    
    ' Add Unrealized Losses MA column
    AddMasterAccountSumColumn tbl, "Unrealized Losses MA", "Total Unrealized Losses"
    
    ' Add Realized Gain/Loss column
    AddRealizedGainLossColumn tbl
    
    ' Add Realized Gain/Loss MA column
    AddMasterAccountSumColumn tbl, "Realized Gain/Loss MA", "Realized Gain/Loss"
End Sub

Private Sub MoveColumn(tbl As ListObject, columnName As String, newPosition As Long)
    Dim oldPosition As Long
    oldPosition = tbl.ListColumns(columnName).Index
    tbl.ListColumns(columnName).Range.Cut
    tbl.ListColumns(newPosition).Range.Insert Shift:=xlToRight
End Sub

Private Sub AddUnrealizedLossesColumn(tbl As ListObject, newColumnName As String, sourceColumnName As String)
    With tbl.ListColumns.Add
        .Name = newColumnName
        .DataBodyRange.FormulaR1C1 = _
            "=SUMIFS(Holdings[" & sourceColumnName & "]," & _
            "Holdings[Account#],[@[Account#]]," & _
            "Holdings[" & sourceColumnName & "],""<0"")"
    End With
End Sub

Private Sub AddTotalUnrealizedLossesColumn(tbl As ListObject)
    With tbl.ListColumns.Add
        .Name = "Total Unrealized Losses"
        .DataBodyRange.FormulaR1C1 = _
            "=[@[Unrealized Short Term Losses]]+[@[Unrealized Long Term Losses]]"
    End With
End Sub

Private Sub AddMasterAccountSumColumn(tbl As ListObject, newColumnName As String, sourceColumnName As String)
    With tbl.ListColumns.Add
        .Name = newColumnName
        .DataBodyRange.FormulaR1C1 = _
            "=SUMIF(Relationships[Master Account Name],[@[Master Account Name]]," & _
            "Relationships[" & sourceColumnName & "])"
    End With
End Sub

Private Sub AddRealizedGainLossColumn(tbl As ListObject)
    With tbl.ListColumns.Add
        .Name = "Realized Gain/Loss"
        .DataBodyRange.FormulaR1C1 = _
            "=[@[Gain/Loss Short Term Ytd]]+[@[Gain/Loss Long Term Ytd]]"
    End With
End Sub

' In ThisWorkbook module
Private Sub Workbook_Open()
    fileImporter.Show
End Sub
