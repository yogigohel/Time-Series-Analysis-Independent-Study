Private Sub cmdBrowseHoldings_Click()
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = "Select Holdings File"
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xls; *.xlsx; *.xlsm; *.csv", 1
        .AllowMultiSelect = False
        If .Show = -1 Then
            txtHoldingsFile.Text = .SelectedItems(1)
        End If
    End With
End Sub

Private Sub cmdBrowseRelationships_Click()
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    With fd
        .Title = "Select Relationships File"
        .Filters.Clear
        .Filters.Add "Excel Files", "*.xls; *.xlsx; *.xlsm; *.csv", 1
        .AllowMultiSelect = False
        If .Show = -1 Then
            txtRelationshipsFile.Text = .SelectedItems(1)
        End If
    End With
End Sub

Private Sub cmdProceed_Click()
    Dim HoldingsFile As String
    Dim RelationshipsFile As String
    HoldingsFile = txtHoldingsFile.Text
    RelationshipsFile = txtRelationshipsFile.Text
    If HoldingsFile = "" Or RelationshipsFile = "" Then
        MsgBox "Please select both Holdings and Relationships files.", vbExclamation
        Exit Sub
    End If
    Me.Hide ' Hide the UserForm

    ' Import the files
    ImportFile HoldingsFile, "Holdings"
    ImportFile RelationshipsFile, "Relationships"

    ' Turn the data on the imported sheets into tables named “Holdings” and “Relationships”
    CreateTableFromSheet "Holdings"
    CreateTableFromSheet "Relationships"

    ' Perform data manipulations
    ManipulateData

    ' Close the UserForm
    Unload Me

    MsgBox "Data import and processing completed successfully.", vbInformation
End Sub

Private Sub cmdCancel_Click()
    Unload Me
End Sub

