' Columns in Master_Table:
'   (1) Account#
'   (2) Acct Name
'   (3) Master Acct ID
'   (4) Master Acct Name
'   (5) Investment Solution
'   (6) Total Market Value
'   (7) Relationship Name
'   (8) Last Meeting Date
'   (9) Next Meeting Date
'   (10) Meeting Notes
'   (11) Meeting Frequency (Days)

' Relationship_Builder layout:
'   Cell B2: Relationship Name
'   Cell B3: Meeting Frequency (Days)
'   Row5: [Headers => "Account#", "Account Name"]
'   Row6+: data

Public Sub LoadOrCreateRelationship()
    Dim wsB As Worksheet, wsM As Worksheet
    Dim relName As String, freq As Variant
    Dim lrM As Long, i As Long, rowDest As Long
    
    Set wsB = ThisWorkbook.Worksheets(SH_RELATIONSHIP_BUILDER)
    Set wsM = ThisWorkbook.Worksheets(SH_MASTER_TABLE)
    
    ' 1) Read the Relationship Name from B2
    relName = Trim(wsB.Range("B2").Value)
    If relName = "" Then
        MsgBox "Please enter a Relationship Name in B2.", vbExclamation
        Exit Sub
    End If
    
    ' 2) Clear existing rows in Relationship_Builder (except row5 headers)
    wsB.Rows("6:" & wsB.Rows.Count).ClearContents
    
    ' 3) Look in MASTER_TABLE for any accounts that match this relationship
    lrM = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    rowDest = 6
    
    Dim foundAny As Boolean: foundAny = False
    Dim relFreq As Variant, freqCollect As New Collection
    
    For i = 2 To lrM
        If wsM.Cells(i, 7).Value = relName Then ' col7 = Relationship
            foundAny = True
            ' Insert that account into Relationship_Builder
            wsB.Cells(rowDest, 1).NumberFormat = "@"
            wsB.Cells(rowDest, 1).Value = wsM.Cells(i, 1).Text ' account#
            wsB.Cells(rowDest, 2).Value = wsM.Cells(i, 2).Value ' AcctName
            rowDest = rowDest + 1
            
            ' Also collect frequency if set
            relFreq = wsM.Cells(i, 11).Value ' col11
            If IsNumeric(relFreq) And relFreq > 0 Then
                freqCollect.Add relFreq
            End If
        End If
    Next i
    
    ' 4) If we found at least one row, try to unify frequency
    ' If multiple accounts have different freq, we can choose the first or show a note
    If foundAny Then
        If freqCollect.Count > 0 Then
            ' For simplicity, pick the first frequency
            freq = freqCollect.Item(1)
            wsB.Range("B3").Value = freq
        Else
            ' Maybe they had no freq
            wsB.Range("B3").ClearContents
        End If
    Else
        ' No existing relationship found => brand new
        wsB.Range("B3").ClearContents
    End If
    
    MsgBox "Load complete. Accounts for '" & relName & "' shown (if any).", vbInformation
End Sub

Public Sub SaveRelationshipSimple()
    Dim wsB As Worksheet, wsM As Worksheet
    Dim relName As String
    Dim builderRow As Long, lastRowB As Long
    Dim acctNum As String
    Dim foundRow As Long
    
    Set wsB = ThisWorkbook.Worksheets("Relationship_Builder")
    Set wsM = ThisWorkbook.Worksheets("Master_Table")
    
    ' Get the relationship name from cell B2.
    relName = Trim(wsB.Range("B2").Value)
    If relName = "" Then
        MsgBox "Please enter a Relationship Name in cell B2.", vbExclamation
        Exit Sub
    End If
    
    ' Determine the last row in the builder (assumes account numbers start at row 6 in Column A).
    lastRowB = wsB.Cells(wsB.Rows.Count, 1).End(xlUp).Row
    
    ' Loop over each account number in the builder.
    For builderRow = 6 To lastRowB
        acctNum = Trim(wsB.Cells(builderRow, 1).Text)
        If acctNum <> "" Then
            ' Use helper function to find the row for this account in Master_Table.
            foundRow = FindAccountRow(wsM, acctNum)
            If foundRow > 0 Then
                ' If found, update the Relationship Name (assumed to be in column 7).
                wsM.Cells(foundRow, 7).Value = relName
            Else
                ' If not found, add a new row at the bottom of Master_Table.
                Dim newRow As Long
                newRow = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row + 1
                wsM.Cells(newRow, 1).NumberFormat = "@"  ' Ensure text format to preserve leading zeros.
                wsM.Cells(newRow, 1).Value = acctNum
                wsM.Cells(newRow, 7).Value = relName
            End If
        End If
    Next builderRow
    
    MsgBox "Relationship '" & relName & "' saved in Master_Table.", vbInformation
End Sub

' Helper: Finds the row in Master_Table for a given account number.
' Returns 0 if not found.
Public Function FindAccountRow(ws As Worksheet, acctNumber As String) As Long
    Dim lastRow As Long, i As Long
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    For i = 2 To lastRow
        If Trim(ws.Cells(i, 1).Text) = acctNumber Then
            FindAccountRow = i
            Exit Function
        End If
    Next i
    FindAccountRow = 0
End Function

' Finds the row in MASTER_TABLE for a given account# (string).
' Returns 0 if not found.
Private Function FindAccountRow(wsM As Worksheet, acctNumber As String) As Long
    Dim lr As Long, i As Long
    lr = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    For i = 2 To lr
        If Trim(wsM.Cells(i, 1).Text) = acctNumber Then
            FindAccountRow = i
            Exit Function
        End If
    Next i
    FindAccountRow = 0
End Function
