Option Explicit

'=========================================
'      SHEET NAME CONSTANTS
'=========================================
Public Const SH_DATA_UPLOAD As String = "Data_Upload"
Public Const SH_MASTER_TABLE As String = "Master_Table"
Public Const SH_RELATIONSHIPS As String = "Relationships"
Public Const SH_RELATIONSHIP_BUILDER As String = "Relationship_Builder"
Public Const SH_MEETING_CALENDAR As String = "Meeting_Calendar"
Public Const SH_SCHEDULE_VIEW As String = "Schedule_View" ' optional

'=========================================
'      HEADERS FOR DATA IMPORT
'      (EXACT STRINGS in row 1)
'=========================================
Public Const HDR_ACCOUNT_NUM As String = "Account#"
Public Const HDR_ACCT_NAME As String = "Acct Name"
Public Const HDR_MASTER_ACCT_ID As String = "Master Account ID"
Public Const HDR_MASTER_ACCT_NAME As String = "Master Account Name"
Public Const HDR_INVEST_DESC As String = "Investment Solution Desc"
Public Const HDR_TOTAL_VALUE As String = "Total Market Value"

'=========================================
'   1) UPLOAD & PROCESS (Data_Upload)
'=========================================
Public Sub Upload_And_Process_Data()
    Dim wsUp As Worksheet, wsMaster As Worksheet
    Dim lastRowUp As Long, lastRowM As Long
    Dim cAccount As Long, cAcctName As Long
    Dim cMasterID As Long, cMasterName As Long
    Dim cInvestDesc As Long, cValue As Long
    Dim i As Long
    
    Set wsUp = ThisWorkbook.Worksheets(SH_DATA_UPLOAD)
    Set wsMaster = ThisWorkbook.Worksheets(SH_MASTER_TABLE)
    
    ' Find last row in Data_Upload
    lastRowUp = wsUp.Cells(wsUp.Rows.Count, 1).End(xlUp).Row
    If lastRowUp < 2 Then
        MsgBox "No data in 'Data_Upload'!", vbExclamation
        Exit Sub
    End If
    
    ' Identify columns by header
    cAccount = GetColumnByHeader(wsUp, HDR_ACCOUNT_NUM)
    cAcctName = GetColumnByHeader(wsUp, HDR_ACCT_NAME)
    cMasterID = GetColumnByHeader(wsUp, HDR_MASTER_ACCT_ID)
    cMasterName = GetColumnByHeader(wsUp, HDR_MASTER_ACCT_NAME)
    cInvestDesc = GetColumnByHeader(wsUp, HDR_INVEST_DESC)
    cValue = GetColumnByHeader(wsUp, HDR_TOTAL_VALUE)
    
    ' Check found
    If cAccount = 0 Or cAcctName = 0 Or cMasterID = 0 Or cMasterName = 0 Or cInvestDesc = 0 Or cValue = 0 Then
        MsgBox "One or more required headers not found in Data_Upload!", vbCritical
        Exit Sub
    End If
    
    ' Clear existing data in Master_Table except headers
    wsMaster.Rows("2:" & wsMaster.Rows.Count).ClearContents
    
    ' Copy row by row to Master_Table
    ' We'll define Master_Table columns as:
    '   1: Account#
    '   2: Acct Name
    '   3: Master Acct ID
    '   4: Master Acct Name
    '   5: Investment Solution
    '   6: Total Market Value
    '   7: Relationship Name
    '   8: Last Meeting Date
    '   9: Next Meeting Date
    '   10: Meeting Notes
    '   11: Meeting Frequency (optional)
    lastRowM = 2
    
    Dim acctStr As String
    Dim rowIsBlank As Boolean
    
    For i = 2 To lastRowUp
        ' Check if row is empty
        rowIsBlank = (Application.CountA(wsUp.Rows(i)) = 0)
        If Not rowIsBlank Then
            ' Preserve leading zeros for "Account#"
            ' We'll read from .Text (not .Value) and store it as text
            acctStr = wsUp.Cells(i, cAccount).Text ' read displayed text exactly
            
            With wsMaster
                ' Format the destination cell as text to prevent losing zeros
                .Cells(lastRowM, 1).NumberFormat = "@"
                .Cells(lastRowM, 1).Value = acctStr
                
                ' The other columns we can copy normally
                .Cells(lastRowM, 2).Value = wsUp.Cells(i, cAcctName).Value
                .Cells(lastRowM, 3).Value = wsUp.Cells(i, cMasterID).Text    ' also preserve leading zeros if needed
                .Cells(lastRowM, 4).Value = wsUp.Cells(i, cMasterName).Value
                .Cells(lastRowM, 5).Value = wsUp.Cells(i, cInvestDesc).Value
                .Cells(lastRowM, 6).Value = wsUp.Cells(i, cValue).Value
            End With
            
            lastRowM = lastRowM + 1
        End If
    Next i
    
    ' Remove duplicates if necessary based on col 1 (Account#)
    RemoveDuplicates wsMaster, 1
    
    ' Optionally call a routine to maintain relationships if they already exist
    ' (If Master_Table had old Relationship Name data, we might preserve them
    '  by matching Account# from old data. That is a more advanced scenario.
    '  For now, let's keep it straightforward.)
    
    MsgBox "Data imported to Master_Table. Leading zeros preserved for Account#.", vbInformation
End Sub

'=========================================
'   2) RELATIONSHIP BUILDER
'=========================================
' A macro tied to a button "Sync to Relationships" on Relationship_Builder.
' Loops each row on Relationship_Builder and updates the 'Relationships' sheet.
' Then calls UpdateMasterTable_Relationships to ensure those relationships
' appear in Master_Table.
Public Sub Sync_Relationships()
    Dim wsBld As Worksheet, wsRel As Worksheet
    Dim lastRowBld As Long, i As Long
    Dim targetRow As Long
    
    Set wsBld = ThisWorkbook.Worksheets(SH_RELATIONSHIP_BUILDER)
    Set wsRel = ThisWorkbook.Worksheets(SH_RELATIONSHIPS)
    
    ' Clear existing data in 'Relationships' (except headers)
    wsRel.Rows("2:" & wsRel.Rows.Count).ClearContents
    
    ' Find the last row in Relationship_Builder
    lastRowBld = wsBld.Cells(wsBld.Rows.Count, 1).End(xlUp).Row
    If lastRowBld < 2 Then
        MsgBox "No data in 'Relationship_Builder'!", vbExclamation
        Exit Sub
    End If
    
    targetRow = 2
    For i = 2 To lastRowBld
        ' If row is blank, skip
        If Application.CountA(wsBld.Rows(i)) = 0 Then GoTo SkipRow
        
        ' Layout: 
        '   A: Relationship Name
        '   B: Account#
        '   C: (Description / Notes)
        '   D: Frequency (Days)
        '   E: (Action or unused)
        
        With wsRel
            .Cells(targetRow, 1).Value = wsBld.Cells(i, 1).Value ' Relationship Name
            .Cells(targetRow, 2).NumberFormat = "@"             ' Preserve leading zeros for Account# 
            .Cells(targetRow, 2).Value = wsBld.Cells(i, 2).Text
            .Cells(targetRow, 3).Value = wsBld.Cells(i, 3).Value ' Notes or desc
            .Cells(targetRow, 4).Value = wsBld.Cells(i, 4).Value ' Frequency
        End With
        targetRow = targetRow + 1
SkipRow:
    Next i
    
    ' Now update Master_Table to reflect these relationships
    UpdateMasterTable_Relationships
    
    MsgBox "Relationships synced successfully!", vbInformation
End Sub

'=========================================
'   3) UPDATE Master_Table RELATIONSHIPS
'=========================================
' This reads the 'Relationships' sheet and sets the Relationship Name
' in 'Master_Table' for each matching Account#.
' If there's a frequency, we also compute Next Meeting Date from Last Meeting
' or from Today if LastMeeting is blank.
Public Sub UpdateMasterTable_Relationships()
    Dim wsM As Worksheet, wsRel As Worksheet
    Dim lastRowM As Long, lastRowR As Long
    Dim dictRel As Object
    Dim i As Long
    
    Set wsM = ThisWorkbook.Worksheets(SH_MASTER_TABLE)
    Set wsRel = ThisWorkbook.Worksheets(SH_RELATIONSHIPS)
    
    lastRowM = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    lastRowR = wsRel.Cells(wsRel.Rows.Count, 1).End(xlUp).Row
    
    If lastRowM < 2 Or lastRowR < 2 Then Exit Sub
    
    ' Build dictionary keyed by Account#, storing "RelationshipName|Frequency"
    Set dictRel = CreateObject("Scripting.Dictionary")
    
    Dim acct As String, relName As String, freq As Variant
    Dim combo As String
    
    For i = 2 To lastRowR
        acct = Trim(wsRel.Cells(i, 2).Text) ' read as text
        relName = Trim(wsRel.Cells(i, 1).Value)
        freq = wsRel.Cells(i, 4).Value
        
        If acct <> "" And relName <> "" Then
            dictRel(acct) = relName & "|" & freq
        End If
    Next i
    
    Dim j As Long, item As Variant
    Dim lastMeeting As Variant, nextMeeting As Variant
    
    For j = 2 To lastRowM
        acct = Trim(wsM.Cells(j, 1).Text) ' col 1: Account#
        If dictRel.Exists(acct) Then
            item = dictRel(acct)
            relName = Split(item, "|")(0)
            freq = Val(Split(item, "|")(1))
            
            ' Write relationship name (col 7 in Master_Table)
            wsM.Cells(j, 7).Value = relName
            
            ' If frequency is valid, set NextMeeting
            If freq > 0 Then
                lastMeeting = wsM.Cells(j, 8).Value ' col 8
                If IsDate(lastMeeting) Then
                    nextMeeting = DateAdd("d", freq, lastMeeting)
                Else
                    nextMeeting = DateAdd("d", freq, Date)
                End If
                wsM.Cells(j, 9).Value = nextMeeting
            End If
        Else
            ' If not in dictionary, maybe clear relationship columns?
            ' wsM.Cells(j,7).ClearContents
            ' wsM.Cells(j,9).ClearContents
        End If
    Next j
    
    ' Format date columns if desired
    wsM.Range("H:H").NumberFormat = "mm/dd/yyyy" ' Last Meeting
    wsM.Range("I:I").NumberFormat = "mm/dd/yyyy" ' Next Meeting
End Sub

'=========================================
'   4) REFRESH MEETING CALENDAR
'=========================================
Public Sub Refresh_Meeting_Calendar()
    Dim wsCal As Worksheet, wsM As Worksheet
    Dim lastRowM As Long, lastRowCal As Long
    Dim i As Long, destRow As Long
    
    Set wsCal = ThisWorkbook.Worksheets(SH_MEETING_CALENDAR)
    Set wsM = ThisWorkbook.Worksheets(SH_MASTER_TABLE)
    
    ' Clear old data in Meeting_Calendar except headers
    wsCal.Rows("2:" & wsCal.Rows.Count).ClearContents
    
    lastRowM = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    destRow = 2
    
    For i = 2 To lastRowM
        If Application.CountA(wsM.Rows(i)) > 0 Then
            wsCal.Cells(destRow, 1).Value = wsM.Cells(i, 7).Value ' Relationship Name
            wsCal.Cells(destRow, 2).NumberFormat = "@" ' preserve leading zeros for Account#
            wsCal.Cells(destRow, 2).Value = wsM.Cells(i, 1).Text
            wsCal.Cells(destRow, 3).Value = wsM.Cells(i, 2).Value ' Acct Name
            wsCal.Cells(destRow, 4).Value = wsM.Cells(i, 8).Value ' Last Meeting
            wsCal.Cells(destRow, 5).Value = wsM.Cells(i, 9).Value ' Next Meeting
            wsCal.Cells(destRow, 6).Value = wsM.Cells(i, 10).Value ' Meeting Notes
            destRow = destRow + 1
        End If
    Next i
    
    ApplyCalendarConditionalFormatting wsCal, destRow - 1
    MsgBox "Meeting_Calendar refreshed!", vbInformation
End Sub

'=========================================
'   5) OPTIONAL: SCHEDULE VIEW
'=========================================
Public Sub Refresh_Schedule_View()
    Dim wsSched As Worksheet, wsM As Worksheet
    Dim lastRowM As Long, i As Long, destRow As Long
    
    On Error Resume Next
    Set wsSched = ThisWorkbook.Worksheets(SH_SCHEDULE_VIEW)
    On Error GoTo 0
    If wsSched Is Nothing Then Exit Sub
    
    Set wsM = ThisWorkbook.Worksheets(SH_MASTER_TABLE)
    lastRowM = wsM.Cells(wsM.Rows.Count, 1).End(xlUp).Row
    
    wsSched.Rows("2:" & wsSched.Rows.Count).ClearContents
    
    destRow = 2
    For i = 2 To lastRowM
        If Application.CountA(wsM.Rows(i)) > 0 Then
            wsSched.Cells(destRow, 1).Value = wsM.Cells(i, 7).Value ' Relationship Name
            ' Basic logic for status
            Dim nxt As Variant
            nxt = wsM.Cells(i, 9).Value
            If IsDate(nxt) Then
                If nxt < Date Then
                    wsSched.Cells(destRow, 2).Value = "Overdue"
                ElseIf nxt >= Date And nxt <= Date + 7 Then
                    wsSched.Cells(destRow, 2).Value = "Upcoming"
                Else
                    wsSched.Cells(destRow, 2).Value = "Future"
                End If
            Else
                wsSched.Cells(destRow, 2).Value = "No Meeting Scheduled"
            End If
            wsSched.Cells(destRow, 3).Value = wsM.Cells(i, 8).Value ' Last Meeting
            wsSched.Cells(destRow, 4).Value = wsM.Cells(i, 9).Value ' Next Meeting
            destRow = destRow + 1
        End If
    Next i
    
    MsgBox "Schedule_View refreshed!", vbInformation
End Sub

'=========================================
'   HELPER: ApplyCalendarConditionalFormatting
'=========================================
Private Sub ApplyCalendarConditionalFormatting(ws As Worksheet, ByVal lastDataRow As Long)
    If lastDataRow < 2 Then Exit Sub
    Dim rngDates As Range
    Set rngDates = ws.Range("E2:E" & lastDataRow) ' Next Meeting in col E
    
    rngDates.FormatConditions.Delete
    
    ' Overdue < Today
    With rngDates.FormatConditions.Add(Type:=xlCellValue, Operator:=xlLess, Formula1:="=TODAY()")
        .Interior.Color = RGB(255, 0, 0)
    End With
    
    ' Upcoming <= Today+7
    With rngDates.FormatConditions.Add(Type:=xlExpression, Formula1:="=AND(E2>=TODAY(),E2<=TODAY()+7)")
        .Interior.Color = RGB(255, 165, 0)
    End With
    
    ' Future > Today+7
    With rngDates.FormatConditions.Add(Type:=xlExpression, Formula1:="=E2>TODAY()+7")
        .Interior.Color = RGB(0, 255, 0)
    End With
End Sub

'=========================================
'   HELPER: GetColumnByHeader
'=========================================
Private Function GetColumnByHeader(ws As Worksheet, hdrName As String) As Long
    Dim rngFound As Range
    Set rngFound = ws.Rows(1).Find(What:=hdrName, LookIn:=xlValues, LookAt:=xlWhole)
    If rngFound Is Nothing Then
        GetColumnByHeader = 0
    Else
        GetColumnByHeader = rngFound.Column
    End If
End Function

'=========================================
'   HELPER: RemoveDuplicates
'   Removes duplicates based on colIndex,
'   with the first row as header.
'=========================================
Private Sub RemoveDuplicates(ws As Worksheet, colIndex As Long)
    Dim lr As Long
    lr = ws.Cells(ws.Rows.Count, colIndex).End(xlUp).Row
    If lr < 2 Then Exit Sub
    ws.Range("A1").CurrentRegion.RemoveDuplicates Columns:=colIndex, Header:=xlYes
End Sub
