' 5) Helper Functions and Routines
'==============================================================================
 
' Helper: Finds the row in Master_Table for a given account number.
' Returns 0 if not found.
Public Function FindAccountRow(ws As Worksheet, acctNumber As String) As Long
    Dim rngFound As Range
    With ws.Columns(1)
        Set rngFound = .Find(What:=acctNumber, LookIn:=xlValues, LookAt:=xlWhole, MatchCase:=False)
        If Not rngFound Is Nothing Then
            FindAccountRow = rngFound.Row
        Else
            FindAccountRow = 0
        End If
    End With
End Function
 
' Helper: Get the column number in a worksheet based on a header in row 1.
Public Function GetColumnByHeader(ws As Worksheet, hdrName As String) As Long
    Dim rngFound As Range
    Set rngFound = ws.Rows(1).Find(What:=hdrName, LookIn:=xlValues, LookAt:=xlWhole)
    If rngFound Is Nothing Then
        GetColumnByHeader = 0
    Else
        GetColumnByHeader = rngFound.Column
    End If
End Function
 
' Helper: Remove duplicates from the current region based on a specified column.
Public Sub RemoveDuplicates(ws As Worksheet, colIndex As Long)
    Dim lr As Long
    lr = ws.Cells(ws.Rows.Count, colIndex).End(xlUp).Row
    If lr < 2 Then Exit Sub
    ws.Range("A1").CurrentRegion.RemoveDuplicates Columns:=colIndex, Header:=xlYes
End Sub
 
' Helper: Apply conditional formatting to the Next Meeting Date column in Meeting_Calendar.
Public Sub ApplyCalendarConditionalFormatting(ws As Worksheet, lastDataRow As Long)
    If lastDataRow < 2 Then Exit Sub
    Dim rngDates As Range
    ' Assume Next Meeting Date is in column E
    Set rngDates = ws.Range("E2:E" & lastDataRow)
    rngDates.FormatConditions.Delete
    
    ' Overdue: Next Meeting < Today (Red)
    With rngDates.FormatConditions.Add(Type:=xlCellValue, Operator:=xlLess, Formula1:="=TODAY()")
        .Interior.Color = RGB(255, 0, 0)
    End With
    
    ' Upcoming: Next Meeting between Today and Today+7 (Orange)
    With rngDates.FormatConditions.Add(Type:=xlExpression, Formula1:="=AND(E2>=TODAY(),E2<=TODAY()+7)")
        .Interior.Color = RGB(255, 165, 0)
    End With
    
    ' Future: Next Meeting > Today+7 (Green)
    With rngDates.FormatConditions.Add(Type:=xlExpression, Formula1:="=E2>TODAY()+7")
        .Interior.Color = RGB(0, 255, 0)
    End With
End Sub
