'---------------------------------------------------------------------------------\
' modUtilities: Helper functions for row-finding, highlighting, and logging changes.\
'---------------------------------------------------------------------------------\
\
'---------------------------------------------------------------------------------\
' FUNCTION: FindAccountRow\
' Returns the row in "Account Data" for a given Relationship#, MasterID, Account# combo.\
' Returns 0 if not found.\
'---------------------------------------------------------------------------------\
Public Function FindAccountRow(ByVal relNum As String, _\
                               ByVal masterID As String, _\
                               ByVal acctNum As String) As Long\
    On Error GoTo ErrorHandler\
    Dim ws As Worksheet\
    Dim lastRow As Long, i As Long\
    \
    Set ws = ThisWorkbook.Worksheets(SH_ACCOUNT_DATA)\
    lastRow = ws.Cells(ws.Rows.Count, acRelNum).End(xlUp).Row\
    \
    For i = 2 To lastRow\
        If ws.Cells(i, acRelNum).Value = relNum _\
           And ws.Cells(i, acMasterID).Value = masterID _\
           And ws.Cells(i, acAcctNum).Value = acctNum Then\
            FindAccountRow = i\
            Exit Function\
        End If\
    Next i\
    \
    FindAccountRow = 0\
    \
CleanExit:\
    Exit Function\
\
ErrorHandler:\
    MsgBox "Error in FindAccountRow: " & Err.Description, vbCritical\
    Resume CleanExit\
End Function\
\
'---------------------------------------------------------------------------------\
' PROCEDURE: HighlightCell\
' Highlights a single cell with the specified RGB color. \
'---------------------------------------------------------------------------------\
Public Sub HighlightCell(ByVal rng As Range, ByVal colorValue As Long)\
    On Error Resume Next\
    rng.Interior.Color = colorValue\
End Sub\
\
'---------------------------------------------------------------------------------\
' PROCEDURE: LogChange\
' Appends a row to "Change Log" with relevant details.\
'---------------------------------------------------------------------------------\
Public Sub LogChange(ByVal actionDesc As String, _\
                     ByVal affectedData As String, _\
                     Optional ByVal oldVal As String = "", _\
                     Optional ByVal newVal As String = "")\
    On Error GoTo ErrorHandler\
    Dim ws As Worksheet\
    Dim nextRow As Long\
    \
    Set ws = ThisWorkbook.Worksheets(SH_CHANGE_LOG)\
    \
    nextRow = ws.Cells(ws.Rows.Count, chgTimestamp).End(xlUp).Row + 1\
    \
    ws.Cells(nextRow, chgTimestamp).Value = Now\
    ws.Cells(nextRow, chgUser).Value = Environ("USERNAME") ' or Application.UserName\
    ws.Cells(nextRow, chgAction).Value = actionDesc\
    ws.Cells(nextRow, chgAffectedData).Value = affectedData\
    \
    If oldVal <> "" Then ws.Cells(nextRow, chgOldValue).Value = oldVal\
    If newVal <> "" Then ws.Cells(nextRow, chgNewValue).Value = newVal\
    \
CleanExit:\
    Exit Sub\
\
ErrorHandler:\
    MsgBox "Error in LogChange: " & Err.Description, vbCritical\
    Resume CleanExit\
End Sub}