Private selectedFilePath As String\
Private collOverwrites As Collection\
\
'---------------------------------------------------------------------------------\
' UserForm Initialization\
' Clears fields and initializes the Overwrites collection each time the form loads.\
'---------------------------------------------------------------------------------\
Private Sub UserForm_Initialize()\
    Me.lblFilePath.Caption = ""\
    Me.chkAllowDuplicates.Value = False\
    \
    ' Clear the listbox\
    Me.lstPreview.Clear\
    Me.lstPreview.ColumnCount = 6\
    ' Set column widths in points or characters. Adjust as needed:\
    Me.lstPreview.ColumnWidths = "70;120;70;120;70;120"\
    \
    Set collOverwrites = New Collection\
End Sub\
\
'---------------------------------------------------------------------------------\
' BROWSE BUTTON: Lets user pick an external workbook.\
'---------------------------------------------------------------------------------\
Private Sub cmdBrowseFile_Click()\
    On Error GoTo ErrHandler\
    \
    Dim fd As FileDialog\
    Set fd = Application.FileDialog(msoFileDialogFilePicker)\
    \
    With fd\
        .Title = "Select the Accounts File"\
        .Filters.Clear\
        ' Accept .xlsx, .xlsm, .csv, etc.\
        .Filters.Add "Excel Files", "*.xlsx; *.xlsm; *.xls; *.csv", 1\
        .AllowMultiSelect = False\
        \
        If .Show = -1 Then\
            selectedFilePath = .SelectedItems(1)\
            Me.lblFilePath.Caption = selectedFilePath\
            ' Populate preview\
            PreviewData selectedFilePath\
        End If\
    End With\
    \
CleanExit:\
    Exit Sub\
\
ErrHandler:\
    MsgBox "Error in cmdBrowseFile_Click: " & Err.Description, vbCritical\
    Resume CleanExit\
End Sub\
\
'---------------------------------------------------------------------------------\
' PREVIEWDATA: Loads the selected file (first sheet), checks each row for \
' new vs. duplicate, and populates the listbox with multi-column entries.\
'---------------------------------------------------------------------------------\
Private Sub PreviewData(ByVal filePath As String)\
    On Error GoTo ErrHandler\
    \
    Dim wbTemp As Workbook\
    Dim wsTemp As Worksheet\
    Dim lastRow As Long\
    Dim i As Long\
    \
    ' For performance\
    Application.ScreenUpdating = False\
    \
    Set wbTemp = Workbooks.Open(filePath, ReadOnly:=True)\
    Set wsTemp = wbTemp.Sheets(1) ' We assume data is in the first sheet\
    \
    lastRow = wsTemp.Cells(wsTemp.Rows.Count, 1).End(xlUp).Row\
    \
    ' Clear existing items\
    Me.lstPreview.Clear\
    \
    ' Make sure we have 6 columns\
    Me.lstPreview.ColumnCount = 6\
    \
    Dim relNum As String, relName As String\
    Dim masterID As String, masterName As String\
    Dim acctNum As String, acctName As String\
    Dim existingRow As Long\
    Dim newIndex As Long\
    \
    ' (Optional) Insert a header row in the ListBox (manually):\
    ' We do it as a "header" row in the ListBox:\
    newIndex = Me.lstPreview.ListCount\
    Me.lstPreview.AddItem\
    Me.lstPreview.List(newIndex, 0) = "Rel#"\
    Me.lstPreview.List(newIndex, 1) = "Rel Name"\
    Me.lstPreview.List(newIndex, 2) = "MasterID"\
    Me.lstPreview.List(newIndex, 3) = "Master Name"\
    Me.lstPreview.List(newIndex, 4) = "Acct#"\
    Me.lstPreview.List(newIndex, 5) = "Status"\
    \
    For i = 2 To lastRow\
        relNum = CStr(wsTemp.Cells(i, 1).Value)\
        relName = CStr(wsTemp.Cells(i, 2).Value)\
        masterID = CStr(wsTemp.Cells(i, 3).Value)\
        masterName = CStr(wsTemp.Cells(i, 4).Value)\
        acctNum = CStr(wsTemp.Cells(i, 5).Value)\
        acctName = CStr(wsTemp.Cells(i, 6).Value)\
        \
        existingRow = FindAccountRow(relNum, masterID, acctNum)\
        \
        newIndex = Me.lstPreview.ListCount\
        Me.lstPreview.AddItem\
        Me.lstPreview.List(newIndex, 0) = relNum\
        Me.lstPreview.List(newIndex, 1) = relName\
        Me.lstPreview.List(newIndex, 2) = masterID\
        Me.lstPreview.List(newIndex, 3) = masterName\
        Me.lstPreview.List(newIndex, 4) = acctNum\
        \
        If existingRow = 0 Then\
            Me.lstPreview.List(newIndex, 5) = "NEW"\
        Else\
            Me.lstPreview.List(newIndex, 5) = "DUPLICATE"\
        End If\
    Next i\
    \
    wbTemp.Close False\
    Application.ScreenUpdating = True\
    \
CleanExit:\
    Exit Sub\
\
ErrHandler:\
    MsgBox "Error in PreviewData: " & Err.Description, vbCritical\
    Resume CleanExit\
End Sub\
\
'---------------------------------------------------------------------------------\
' IMPORT BUTTON: Calls ProcessUpload to finalize the data import.\
'---------------------------------------------------------------------------------\
Private Sub cmdImport_Click()\
    On Error GoTo ErrHandler\
    \
    If selectedFilePath = "" Then\
        MsgBox "No file selected. Please browse for a file first.", vbExclamation\
        Exit Sub\
    End If\
    \
    Dim allowDup As Boolean\
    allowDup = Me.chkAllowDuplicates.Value\
    \
    ' Build the overwrites collection if you want advanced duplicate selection\
    ' For now, we pass an empty collection or any relevant logic you might add\
    Set collOverwrites = New Collection\
    \
    ' Perform the upload\
    ProcessUpload selectedFilePath, allowDup, collOverwrites\
    \
    MsgBox "Accounts have been uploaded successfully.", vbInformation\
    Unload Me\
    \
CleanExit:\
    Exit Sub\
\
ErrHandler:\
    MsgBox "Error in cmdImport_Click: " & Err.Description, vbCritical\
    Resume CleanExit\
End Sub}